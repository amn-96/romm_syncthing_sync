# ROMM Configuration
# ==================
# ROMM server URL (e.g., http://romm-app:8000 for Docker, http://localhost:8000 for local)
ROMM_URL=http://romm-app:8000

# ROMM credentials
ROMM_USERNAME=user
ROMM_PASSWORD=password

# ROMM API pagination limit (number of games to fetch per request)
# Higher values = fewer API calls, but more memory usage
# Default: 50 (ROMM's default)
ROMM_API_LIMIT=50

# ROMM container name (used for docker stop/start during syncs)
# Only relevant if running ROMM in Docker
ROMM_CONTAINER_NAME=rommapp

# Base directory where ROMM stores files
# Used to determine asset directory paths for saves/states/screenshots
# In Docker: typically /romm_data or wherever the ROMM_DATA volume is mounted
# In Docker Compose: could be /romm_data if mounted from host
ROMM_BASE_DIR=/romm_data

# ROMM Library Cache TTL (Time To Live) in hours
# How long to keep cached ROMM library before refreshing from API
# Default: 1 hour
# Setting to 24 would refresh once per day, reducing API calls significantly
# FUTURE: Only used when LibraryCache class is implemented
ROMM_LIBRARY_TTL_HOURS=1


# Sync Configuration
# ==================
# Local sync folder path (mounted volume in Docker, or local path)
# Expected structure:
#   sync_folder/
#   ├── Nintendo 64/
#   │   ├── Game Name.srm
#   │   ├── Game Name.state
#   │   └── Game Name.state.png
#   └── Game Boy Advance/
#       ├── Another Game.srm
#       └── Another Game.state
SYNC_FOLDER=/data/sync

# Cache file location
# Stores local game catalog between runs to speed up startup
# Should be persistent across container restarts
CACHE_FILE=/data/cache/local_games.json

# Sync interval in seconds (for periodic mode)
# How often to check for changes and sync
# Default: 300 (5 minutes)
# Reduce for more frequent syncs (uses more resources)
# Increase to reduce API/disk load
SYNC_INTERVAL_SECONDS=300

# Sync mode: 'periodic' or 'watch'
# - periodic: Runs sync every SYNC_INTERVAL_SECONDS
# - watch: Monitors filesystem for changes and syncs immediately (TODO: not yet implemented)
# Default: periodic
SYNC_MODE=periodic

# Upload method (currently unused, for future enhancement)
# Options: 'API' (REST), 'direct' (filesystem)
ROMM_UPLOAD_METHOD=API


# Logging Configuration
# =====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Very verbose, includes all API calls and file operations
# INFO: Normal operation logs (recommended)
# WARNING: Only warnings and errors
# ERROR: Only errors
# Default: INFO
LOG_LEVEL=INFO

# Log format (Python logging format)
# Default includes timestamp, logger name, level, and message
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s


# Feature Flags
# =============
# Dry run mode (not yet fully implemented)
# When true, logs what would sync but doesn't actually perform syncs
DRY_RUN=false

# Enable metrics collection (not yet implemented)
# When true, tracks detailed sync statistics and timing information
ENABLE_METRICS=false


# Docker / Container Settings
# =============================
# These are only relevant when running in Docker

# Set to 'true' to stop and restart ROMM container before/after syncs
# Useful if ROMM has file locking issues
# In Docker Compose, set to 'false' if ROMM is in a separate service that doesn't need restarting
DOCKER_ENABLE_ROMM_RESTART=true

# If running outside Docker, set to 'false'
# Affects: container restart logic, path handling, etc.
DOCKER_ENABLED=true
