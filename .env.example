# ROMM Configuration
# ==================
# ROMM server URL. This can be a direct IP:PORT or a reverse-proxied domain. 
# HTTP Authentication needs to be enabled. While romm supports OIDC (and you can still use it there), this app uses only standard http auth.
ROMM_URL=http://romm-app:8000

# ROMM credentials -- HTTP auth
ROMM_USERNAME=user
ROMM_PASSWORD=password

# ROMM API pagination limit (number of games to fetch per request)
# Higher values = fewer API calls, but more memory usage
# Default: 50 (ROMM's default)
ROMM_API_LIMIT=50

# Sync Configuration
# ==================
# Local sync folder path (mounted volume in Docker, or local path)
# Expected structure:
#   sync_folder/
#   ├── Nintendo 64/
#   │   ├── Game Name.srm
#   │   ├── Game Name.state
#   │   └── Game Name.state.png
#   └── Game Boy Advance/
#       ├── Another Game.srm
#       └── Another Game.state
SYNC_FOLDER=/data/sync

# Sync mode: 'periodic' or 'watch'
# - periodic: Runs sync every SYNC_INTERVAL_SECONDS
# - watch: Monitors filesystem for changes and syncs immediately (TODO: not yet implemented)
# Default: periodic
SYNC_MODE=periodic

# Sync interval in seconds (periodic mode)
# How often to check for changes and sync
# Default: 300 (5 minutes)
# Reduce for more frequent syncs (uses more resources)
# Increase to reduce API/disk load
SYNC_INTERVAL_SECONDS=1800

# Time to wait after file events have ceased to begin the sync process (watch mode)
WATCHDOG_DELAY_SECONDS=60  

# Logging Configuration
# =====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Very verbose, includes all API calls and file operations
# INFO: Normal operation logs (recommended)
# WARNING: Only warnings and errors
# ERROR: Only errors
# Default: INFO
LOG_LEVEL=INFO
