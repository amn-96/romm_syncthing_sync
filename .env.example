# ROMM Configuration
# ==================
# ROMM server URL. This can be a direct IP:PORT or a reverse-proxied domain. 
# HTTP Authentication needs to be enabled. While romm supports OIDC (and you can still use it there), this app uses only standard http auth.
ROMM_URL=http://romm-app:8000

# ROMM credentials -- HTTP auth
ROMM_USERNAME=user
ROMM_PASSWORD=password

# ROMM API pagination limit (number of games to fetch per request)
# Higher values = fewer API calls, but more memory usage
# Default: 50 (this is ROMM's default)
ROMM_API_LIMIT=50

# Sync Configuration
# ==================
# Uncomment and set ALL_SYNC_FOLDER *only if your saves and states are organized in the same directory*.
# ALL_SYNC_FOLDER=/data/sync
SAVE_SYNC_FOLDER=/data/sync/saves
STATE_SYNC_FOLDER=/data/sync/states

# These are expected to be used as bind mounts. Follow the pattern in docker-compose.yml

# Sync mode: 'periodic' or 'watch'
# - periodic: Runs sync every SYNC_INTERVAL_SECONDS
# - watch: Monitors filesystem for changes and syncs immediately (TODO: not yet implemented)
# Default: periodic
SYNC_MODE=watch

# (Periodic mode) library sync interval. This also refreshes the romm library.
SYNC_INTERVAL_SECONDS=300

# (Watch mode) Time to wait after file events have ceased to begin the sync process (watch mode)
WATCHDOG_DELAY_SECONDS=60 

PLATFORM_MAP_FILE=./platform_mapping.yaml

# Logging Configuration
# =====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Very verbose, includes all API calls and file operations
# INFO: Normal operation logs (recommended)
LOG_LEVEL=INFO

# set timezone based on your location. Only affects the logging.
# Default will be UTC
TZ=America/Los_Angeles 
